<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('buttons')]/button[hasclass('print')]" position="after">
            <button t-if="currentOrder.is_to_taxfree()"
                    class="button print_taxfree btn btn-lg btn-secondary w-100 py-3 mt-2"
                    t-on-click="click_print_taxfree">
                <i class="fa fa-print me-1" role="img"
                   aria-label="Print Taxfree Button"
                   title="Print Taxfree Button"/>
                Imprimir Tax Free
            </button>
        </xpath>
    </t>

</templates>
