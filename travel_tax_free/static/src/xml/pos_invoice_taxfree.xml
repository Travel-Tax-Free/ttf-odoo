<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">

        <xpath expr="//button[hasclass('js_invoice')]" position="after">
            <button class="button js_taxfree btn btn-light py-3 text-start rounded-0 border-bottom"
                    t-att-class="{ 'highlight text-bg-primary': currentOrder.is_to_taxfree() }"
                    t-on-click="click_taxfree">
                <i class="fa fa-suitcase me-2" />Factura + Tax Free
            </button>
        </xpath>
    </t>
</templates>
